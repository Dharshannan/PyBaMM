# Stage-1 shared set "v4a" (2026-10-04) = crack_baseline_v3 + saturating cathode LAM.
# Use on top of ../crack_baseline_v3.env (rpt_soc_plots.py loads that by default):
#   ./run.sh TAG 25|45 $(grep -v '^#' stage1_v4a.env | xargs)
# Cathode stress-driven LAM: "power" damping, (eps/eps0)^50 on the stress, beta x120,
# isothermal Arrhenius -55 kJ/mol (exactly 1 at 25 degC; ~4x slower at 45 degC).
# 25 degC (S1b): LAM_PE 6.6% at EFC 197 (real 6.9), mean SoH gap 2.2pp.
# 45 degC (S1e): LAM_PE 3.2->5.0% (real 3.0-5.1), mean SoH gap 1.1pp.
C64_POS_STRESS_LAM_DAMP_EXP=50
C64_POS_LAM_MULT=120
C64_POS_LAM_EAC=-55000
