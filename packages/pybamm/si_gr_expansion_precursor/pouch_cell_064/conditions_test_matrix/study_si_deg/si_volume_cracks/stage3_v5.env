# Stage-3 shared set "v5" (2026-10-05) = crack_baseline_v3 + stage1_v4a cathode law + route B.
# ONE parameter set for 25 degC (CELL064), 45 degC (CELL017) and 15-95% (CELL009); per condition
# only T, F0 (first-RPT k) and WIDTH differ (CELL009: RPT_C64_WIDTH=1e-3).
#   ./run.sh TAG 25|45|25p1595|25p2080 $(grep -v '^#' stage3_v5.env | xargs) [RPT_C64_WIDTH=1e-3]
# Cathode stress-driven LAM: power damping n=50, beta x120, Ea -55 kJ/mol (stage 1, v4a).
C64_POS_STRESS_LAM_DAMP_EXP=50
C64_POS_LAM_MULT=120
C64_POS_LAM_EAC=-55000
# Route A (Paris on diffusion stress): k_cr x0.75e3 (v3: 1e3), SI_CRACK_EAC 90 kJ/mol (v3, slower when hot).
C64_SI_CRACK_MULT=0.75e3
# Route B (strain fatigue, contraction only): k_V 2.3e-3 (set by CELL009's knee),
# E_V +120 kJ/mol in the SI_CRACK_EAC convention (slower when hot; k_V /21 at 45 degC).
C64_SI_STRAIN_CRACK_MODE=contraction
C64_SI_STRAIN_CRACK_KV=2.3e-3
C64_SI_STRAIN_CRACK_EA=120000
