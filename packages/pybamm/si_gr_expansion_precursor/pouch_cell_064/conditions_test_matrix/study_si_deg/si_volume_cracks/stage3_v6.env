# Stage-3 shared set "v6" (2026-10-05) = crack_baseline_v3 + stage1_v4a cathode law + route B.
# Supersedes v5: Paris back to v3's 1e3 (earlier 25 degC knee, per user), E_V 150 kJ/mol.
# ONE parameter set for 25 degC (CELL064), 45 degC (CELL017), 15-95% (CELL009) and 20-80% (CELL026);
# per condition only T, F0 (first-RPT k) and WIDTH differ (CELL009 RPT_C64_WIDTH=1e-3, CELL026 3e-4).
#   ./run.sh TAG 25|45|25p1595|25p2080 $(grep -v '^#' stage3_v6.env | xargs) [RPT_C64_WIDTH=...]
# Cathode stress-driven LAM: power damping n=50, beta x120, Ea -55 kJ/mol (stage 1, v4a).
C64_POS_STRESS_LAM_DAMP_EXP=50
C64_POS_LAM_MULT=120
C64_POS_LAM_EAC=-55000
# Route A (Paris on diffusion stress): v3 values (C64_SI_CRACK_MULT 1e3, SI_CRACK_EAC +90 kJ/mol).
# Route B (strain fatigue, contraction only): k_V 2.3e-3 (CELL009 knee); E_V +150 kJ/mol in the
# SI_CRACK_EAC convention (positive = slower when hot; k_V /45 at 45 degC).
C64_SI_STRAIN_CRACK_MODE=contraction
C64_SI_STRAIN_CRACK_KV=2.3e-3
C64_SI_STRAIN_CRACK_EA=150000
