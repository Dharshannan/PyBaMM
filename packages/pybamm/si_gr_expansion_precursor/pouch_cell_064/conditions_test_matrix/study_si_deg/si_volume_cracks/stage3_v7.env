# Stage-3 shared set "v7" (2026-10-20) = v6 refitted on the corrected test protocols
# (RPTs at 25 degC, C/20 RPT charge, every CV to C/50; aligned_rpt_cycling.py and
# rpt_soc_plots.py defaults since 2026-10-20). Changes from v6: k_V x1.15, Paris x0.85.
# Matches paper/sigr V7 (paper branch) with the dose gate and the 2.5947 Ah basis:
#   ./run.sh TAG 25|45|25p1595|25p2080 $(grep -v '^#' stage3_v7.env | xargs) [RPT_C64_WIDTH=...]
# Per condition only T, F0 (first-RPT k) and WIDTH differ (CELL009 RPT_C64_WIDTH=1e-3, CELL026 3e-4).
C64_POS_STRESS_LAM_DAMP_EXP=50
C64_POS_LAM_MULT=120
C64_POS_LAM_EAC=-55000
# Route A (Paris): 1e3 x0.85
C64_SI_CRACK_MULT=850
# Route B (strain fatigue, contraction only): 2.3e-3 x1.15
C64_SI_STRAIN_CRACK_MODE=contraction
C64_SI_STRAIN_CRACK_KV=2.645e-3
C64_SI_STRAIN_CRACK_EA=150000
# Paper configuration
C64_ISO_GATE_FORM=dose
C64_RATE_BASIS_AH=2.5947
C64_EFC_BASIS_AH=2.5947
